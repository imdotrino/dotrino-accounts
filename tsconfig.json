{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server.js", "src/**/*.js", "src/**/*.d.ts", "scripts/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist", "coverage", "test"]
}
